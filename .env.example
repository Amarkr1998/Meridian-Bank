# Meridian Bank — local environment variables (example)
#
# Copy this file to `.env` in the repository root and adjust if needed.
# `.env` is gitignored — never commit real secrets, even local-dev ones.
# These are LOCAL DEMO defaults only; they are not, and must never be, production credentials.

# --- PostgreSQL ---
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian_local_dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Kafka (external/host-facing listener) ---
KAFKA_PORT=9092

# --- auth-service ---
AUTH_SERVICE_PORT=8081

# LOCAL/DEMO DEFAULT ONLY — never reuse outside local development. Must be >= 32 bytes for HS256.
MERIDIAN_JWT_SECRET=meridian-bank-local-demo-jwt-signing-secret-change-me-32bytes-min

# Seeded on first startup so there's a way into the ADMIN-only staff provisioning endpoint.
# LOCAL/DEMO DEFAULT ONLY.
MERIDIAN_ADMIN_EMAIL=admin@meridianbank.local
MERIDIAN_ADMIN_PASSWORD=ChangeMe!Local1

# --- customer-kyc-service ---
CUSTOMER_KYC_SERVICE_PORT=8082

# --- account-service ---
ACCOUNT_SERVICE_PORT=8083

# --- payment-service ---
PAYMENT_SERVICE_PORT=8084

# --- ledger-service ---
LEDGER_SERVICE_PORT=8085

# --- fraud-risk-service ---
FRAUD_RISK_SERVICE_PORT=8086

# --- audit-service ---
AUDIT_SERVICE_PORT=8087

# --- notification-service ---
NOTIFICATION_SERVICE_PORT=8088

# --- api-gateway ---
API_GATEWAY_PORT=8080

# Origins allowed to call the gateway from a browser (comma-separated). Default matches the
# Vite dev server the customer portal (Phase 14) runs on.
MERIDIAN_GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Local Compose allowance for cold JVM/password-hashing paths under workstation contention.
MERIDIAN_GATEWAY_UPSTREAM_READ_TIMEOUT_MS=30000

# --- Prometheus (Phase 16) ---
PROMETHEUS_PORT=9090

# --- Grafana (Phase 16) ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# LOCAL/DEMO DEFAULT ONLY — never reuse outside local development.
GRAFANA_ADMIN_PASSWORD=ChangeMe!Local1
